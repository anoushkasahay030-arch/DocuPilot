# No API keys required. Start Ollama and run: ollama pull qwen2.5:7b

# Optional overrides
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b              # routing, SQL, verification; also synthesis by default
# OLLAMA_STRONG_MODEL=qwen2.5:7b       # optional separate synthesis model; unset = OLLAMA_MODEL
# OLLAMA_NUM_CTX=16384                # context window in tokens; larger values use more memory
# OLLAMA_TIMEOUT_S=300                # request/read timeout, including model loading
# DATA_DIR=data
# TOP_K=8
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-12-v2   # or BAAI/bge-reranker-base (slower)
# USE_OCR=false
