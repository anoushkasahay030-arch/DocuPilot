# Required
GEMINI_API_KEY=your-key-here

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash          # fast model: routing, SQL, verification
# GEMINI_STRONG_MODEL=gemini-3.8-flash   # answer synthesis
# STRONG_THINKING_BUDGET=               # unset = model default; 0 = no thinking (faster first token)
# DATA_DIR=data
# TOP_K=8
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-12-v2   # or BAAI/bge-reranker-base (slower)
# USE_OCR=false
